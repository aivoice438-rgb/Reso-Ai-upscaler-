@Composable
fun EditorSettingsPanel(config: EnhanceConfig, viewModel: ResoViewModel) {
    var selectedTab by remember { mutableStateOf(0) }
    val tabs = listOf("AI Model", "Parameters", "Export")

    Column(modifier = Modifier.fillMaxSize()) {
        // Tab Row
        Row(modifier = Modifier.fillMaxWidth().padding(16.dp), horizontalArrangement = Arrangement.SpaceEvenly) {
            tabs.forEachIndexed { index, title ->
                Text(
                    text = title,
                    color = if (selectedTab == index) ResoCyanGlow else ResoTextSecondary,
                    fontWeight = if (selectedTab == index) FontWeight.Bold else FontWeight.Normal,
                    modifier = Modifier.clickable { selectedTab = index }.padding(8.dp)
                )
            }
        }
        Divider(color = Color.DarkGray)

        LazyColumn(modifier = Modifier.fillMaxSize().padding(horizontal = 16.dp)) {
            when (selectedTab) {
                0 -> item { ModelSelectionScreen(config, viewModel) }
                1 -> item { ParameterAdjustmentScreen(config, viewModel) }
                2 -> item { ExportSettingsScreen(config, viewModel) }
            }
        }
    }
}

@Composable
fun ModelSelectionScreen(config: EnhanceConfig, viewModel: ResoViewModel) {
    Spacer(modifier = Modifier.height(16.dp))
    Text("Video Type", color = Color.White, fontWeight = FontWeight.Bold)
    Spacer(modifier = Modifier.height(8.dp))
    Row(modifier = Modifier.fillMaxWidth(), horizontalArrangement = Arrangement.spacedBy(8.dp)) {
        VideoType.values().forEach { type ->
            FilterChip(
                selected = config.videoType == type,
                onClick = { viewModel.updateConfig(config.copy(videoType = type)) },
                label = { Text(type.name) },
                colors = FilterChipDefaults.filterChipColors(selectedContainerColor = ResoBlueAccent, selectedLabelColor = Color.White)
            )
        }
    }

    Spacer(modifier = Modifier.height(24.dp))
    Text("AI Enhancement Model", color = Color.White, fontWeight = FontWeight.Bold)
    Spacer(modifier = Modifier.height(8.dp))
    
    AiModel.values().forEach { model ->
        val isSelected = config.aiModel == model
        Column(
            modifier = Modifier
                .fillMaxWidth()
                .padding(vertical = 4.dp)
                .clip(RoundedCornerShape(12.dp))
                .background(if (isSelected) ResoBlueAccent.copy(alpha = 0.2f) else ResoDark)
                .border(1.dp, if (isSelected) ResoBlueAccent else Color.Transparent, RoundedCornerShape(12.dp))
                .clickable { viewModel.updateConfig(config.copy(aiModel = model)) }
                .padding(16.dp)
        ) {
            Text(model.title, color = if (isSelected) ResoCyanGlow else Color.White, fontWeight = FontWeight.Bold)
            Spacer(modifier = Modifier.height(4.dp))
            Text(model.description, color = ResoTextSecondary, fontSize = 12.sp)
        }
    }
}

@Composable
fun ParameterAdjustmentScreen(config: EnhanceConfig, viewModel: ResoViewModel) {
    Spacer(modifier = Modifier.height(16.dp))
    
    // Presets Row
    Text("Presets", color = Color.White, fontWeight = FontWeight.Bold)
    Spacer(modifier = Modifier.height(8.dp))
    androidx.compose.foundation.lazy.LazyRow(horizontalArrangement = Arrangement.spacedBy(8.dp)) {
        items(Preset.values().toList()) { preset ->
            Button(
                onClick = { viewModel.applyPreset(preset) },
                colors = ButtonDefaults.buttonColors(containerColor = ResoDark)
            ) { Text(preset.name) }
        }
    }

    Spacer(modifier = Modifier.height(24.dp))
    Text("Manual Parameters", color = Color.White, fontWeight = FontWeight.Bold)
    Spacer(modifier = Modifier.height(16.dp))

    val p = config.params
    val updateParams: (EnhanceParams) -> Unit = { viewModel.updateConfig(config.copy(params = it)) }

    ResoSlider("Fix Compression", p.fixCompression, 0f, 100f) { updateParams(p.copy(fixCompression = it)) }
    ResoSlider("Improve Detail", p.improveDetail, 0f, 100f) { updateParams(p.copy(improveDetail = it)) }
    ResoSlider("Sharpen", p.sharpen, 0f, 100f) { updateParams(p.copy(sharpen = it)) }
    ResoSlider("Reduce Noise", p.reduceNoise, 0f, 100f) { updateParams(p.copy(reduceNoise = it)) }
    ResoSlider("Dehalo", p.dehalo, 0f, 100f) { updateParams(p.copy(dehalo = it)) }
    ResoSlider("Anti-Alias / Deblur", p.antiAlias, -100f, 100f) { updateParams(p.copy(antiAlias = it)) }
    ResoSlider("Add Noise", p.addNoise, 0f, 100f) { updateParams(p.copy(addNoise = it)) }
    ResoSlider("Recover Detail", p.recoverDetail, 0f, 100f) { updateParams(p.copy(recoverDetail = it)) }
    
    Spacer(modifier = Modifier.height(32.dp))
}

@Composable
fun ResoSlider(label: String, value: Float, min: Float, max: Float, onValueChange: (Float) -> Unit) {
    Column(modifier = Modifier.fillMaxWidth().padding(vertical = 8.dp)) {
        Row(modifier = Modifier.fillMaxWidth(), horizontalArrangement = Arrangement.SpaceBetween) {
            Text(label, color = Color.White, fontSize = 14.sp)
            Text(value.toInt().toString(), color = ResoCyanGlow, fontSize = 14.sp)
        }
        Slider(
            value = value,
            onValueChange = onValueChange,
            valueRange = min..max,
            colors = SliderDefaults.colors(
                thumbColor = ResoCyanGlow,
                activeTrackColor = ResoBlueAccent,
                inactiveTrackColor = ResoDark
            )
        )
    }
}

