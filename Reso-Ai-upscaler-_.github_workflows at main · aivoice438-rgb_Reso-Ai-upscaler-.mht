}

enum class VideoType { Progressive, Interlaced, AutoDetect }
enum class AiModel(val title: String, val description: String) {
    ProEnhance("Pro-Enhance", "General enhancement & high fidelity (Proteus-style)"),
    FaceRestore("Face-Restore", "Focus on facial detail recovery (Iris-style)"),
    DetailRestore("Detail-Restore", "General restoration for degraded media (Artemis-style)"),
    DeInterlace("De-Interlace", "Restoration for interlaced footage (Dione-style)")
}

data class EnhanceParams(
    var fixCompression: Float = 0f,
    var improveDetail: Float = 50f,
    var sharpen: Float = 15f,
    var reduceNoise: Float = 10f,
    var dehalo: Float = 0f,
    var antiAlias: Float = 0f,
    var addNoise: Float = 0f,
    var recoverDetail: Float = 20f
)

enum class Preset(val title: String, val params: EnhanceParams) {
    Anime("Anime Enhancement", EnhanceParams(10f, 60f, 20f, 50f, 10f, 30f, 0f, 40f)),
    Gaming("Gaming Edits", EnhanceParams(5f, 80f, 40f, 10f, 0f, 10f, 0f, 60f)),
    LowQuality("Low-Quality Video", EnhanceParams(80f, 70f, 30f, 80f, 20f, 10f, 5f, 50f)),
    Face("Face Enhancement", EnhanceParams(20f, 40f, 15f, 20f, 0f, 0f, 0f, 80f)),
    Balanced("Balanced Quality", EnhanceParams(10f, 50f, 15f, 10f, 0f, 0f, 2f, 20f))
}

data class EnhanceConfig(
    val videoUri: Uri,
    val videoType: VideoType = VideoType.AutoDetect,
    val aiModel: AiModel = AiModel.ProEnhance,
    val params: EnhanceParams = EnhanceParams(),
    val resolutionMode: String = "1080p",
    val fpsMode: String = "Source",
    val enableInterpolation: Boolean = false
)

class ResoViewModel : ViewModel() {
    private val _currentScreen = MutableStateFlow<Screen>(Screen.Splash)
    val currentScreen: StateFlow<Screen> = _currentScreen.asStateFlow()

    private val _config = MutableStateFlow<EnhanceConfig?>(null)
    val config: StateFlow<EnhanceConfig?> = _config.asStateFlow()

    fun navigateTo(screen: Screen) {
        _currentScreen.value = screen
    }

    fun initEditor(uri: Uri) {
        _config.value = EnhanceConfig(videoUri = uri)
        navigateTo(Screen.Editor(uri))
    }

    fun updateConfig(newConfig: EnhanceConfig) {
        _config.value = newConfig
    }

    fun applyPreset(preset: Preset) {
        _config.value = _config.value?.copy(params = preset.params.copy())
    }
}

@Composable
fun ResoApp(viewModel: ResoViewModel = viewModel()) {
    val currentScreen by viewModel.currentScreen.collectAsState()

    Surface(modifier = Modifier.fillMaxSize(), color = MaterialTheme.colorScheme.background) {
        Crossfade(targetState = currentScreen, animationSpec = tween(600), label = "ScreenTransition") { screen ->
            when (screen) {
                is Screen.Splash -> SplashScreen(onFinish = { viewModel.navigateTo(Screen.Home) })
                is Screen.Home -> HomeScreen(onVideoSelect = { uri -> viewModel.initEditor(uri) })
                is Screen.Editor -> EditorScreen(uri = screen.videoUri, viewModel = viewModel)
                is Screen.Exporting -> ExportScreen(config = screen.config, onFinish = { viewModel.navigateTo(Screen.Home) })
            }
        }
    }
}

@Composable
fun SplashScreen(onFinish: () -> Unit) {
    val scale = remember { Animatable(0.8f) }
    val alpha = remember { Animatable(0f) }
    
    LaunchedEffect(Unit) {
        launch { scale.animateTo(1.0f, animationSpec = tween(1500, easing = FastOutSlowInEasing)) }
        launch { alpha.animateTo(1.0f, animationSpec = tween(1000)) }
        delay(2500)
        alpha.animateTo(0f, animationSpec = tween(500))
        onFinish()
    }

    Box(modifier = Modifier.fillMaxSize().background(ResoDark), contentAlignment = Alignment.Center) {
        // Subtle particle background effect
        Canvas(modifier = Modifier.fillMaxSize()) {
            val width = size.width
            val height = size.height
            for (i in 0..50) {
                val x = Random.nextFloat() * width
                val y = Random.nextFloat() * height
                val radius = Random.nextFloat() * 3f
                drawCircle(
                    color = ResoBlueAccent.copy(alpha = Random.nextFloat() * 0.5f),
                    radius = radius,
                    center = Offset(x, y)
                )
            }
        }
        
        Column(horizontalAlignment = Alignment.CenterHorizontally, modifier = Modifier.scale(scale.value).alpha(alpha.value)) {
            Icon(
                imageVector = Icons.Default.PlayArrow,
                contentDescription = "Logo",
                tint = ResoCyanGlow,
                modifier = Modifier.size(80.dp)
            )
            Spacer(modifier = Modifier.height(16.dp))
            Text("RESO AI", style = MaterialTheme.typography.headlineLarge, color = Color.White)
            Spacer(modifier = Modifier.height(8.dp))
            Text("ENHANCE EVERY FRAME", style = MaterialTheme.typography.bodyMedium.copy(letterSpacing = 4.sp), color = ResoBlueAccent)
        }
    }
}

